import { useState } from 'react'
import './App.css'

function App() {
  const [started, setStarted] = useState(false)
  const [activeTool, setActiveTool] = useState(null)

  // Crop Recommendation
  const [soil, setSoil] = useState('')
  const [season, setSeason] = useState('')
  const [water, setWater] = useState('')
  const [recommendation, setRecommendation] = useState('')

  // Crop Health
  const [healthCrop, setHealthCrop] = useState('')
  const [symptom, setSymptom] = useState('')
  const [healthResult, setHealthResult] = useState(null)

  // Weather
  const [location, setLocation] = useState('')
  const [weatherResult, setWeatherResult] = useState(null)
  const [weatherError, setWeatherError] = useState('')
  const [weatherLoading, setWeatherLoading] = useState(false)

  // Irrigation
  const [irrigationCrop, setIrrigationCrop] = useState('')
  const [irrigationSoil, setIrrigationSoil] = useState('')
  const [irrigationResult, setIrrigationResult] = useState('')

  // AI Assistant
  const [question, setQuestion] = useState('')
  const [aiResult, setAiResult] = useState('')
  const [aiLoading, setAiLoading] = useState(false)

  // --------------------------------------------------
  // CROP RECOMMENDATION
  // --------------------------------------------------

  const recommendCrop = () => {
    if (!soil || !season || !water) {
      setRecommendation(
        'Please select soil type, season and water availability first.'
      )
      return
    }

    if (soil === 'black' && water === 'high') {
      setRecommendation(
        '🌾 Recommended Crop: Cotton — Black soil with good water availability can be suitable for cotton.'
      )
    } else if (soil === 'loamy' && water === 'moderate') {
      setRecommendation(
        '🌱 Recommended Crop: Groundnut — Loamy soil with moderate water availability can be suitable for groundnut.'
      )
    } else if (season === 'rabi' && water === 'low') {
      setRecommendation(
        '🌾 Recommended Crop: Chickpea — Chickpea can perform well during Rabi with relatively limited water.'
      )
    } else if (soil === 'red' && water === 'low') {
      setRecommendation(
        '🌾 Recommended Crop: Millet — Millets can be considered where water availability is limited.'
      )
    } else if (season === 'kharif' && water === 'high') {
      setRecommendation(
        '🌱 Recommended Crop: Rice — High water availability during Kharif may support rice cultivation.'
      )
    } else {
      setRecommendation(
        '🌱 Recommended Crop: Millet — A potentially suitable option for moderate or limited-water conditions.'
      )
    }
  }

  // --------------------------------------------------
  // CROP HEALTH
  // --------------------------------------------------

  const checkHealth = () => {
    if (!healthCrop || !symptom) {
      setHealthResult({
        level: 'warning',
        title: 'Missing Information',
        severity: '—',
        cause: 'Crop and symptom information are required.',
        action: 'Select both the crop and observed symptom.',
        prevention: 'Provide clear observations for a better assessment.'
      })
      return
    }

    const results = {
      spots: {
        level: 'danger',
        title: 'Possible Leaf Spot / Fungal Stress',
        severity: 'Moderate',
        cause:
          'Leaf spots may be associated with fungal disease, environmental stress or other crop-health problems.',
        action:
          'Inspect affected leaves carefully and monitor whether the symptoms are spreading. Confirm the condition before applying any pesticide or fungicide.',
        prevention:
          'Maintain suitable plant spacing, monitor moisture and regularly inspect new symptoms.'
      },

      yellow: {
        level: 'warning',
        title: 'Possible Nutrient or Water Stress',
        severity: 'Low–Moderate',
        cause:
          'Yellow leaves can be associated with nutrient deficiency, excess water, insufficient water or root-related stress.',
        action:
          'Check soil moisture first. Compare affected and healthy plants and review recent fertilizer and irrigation practices before making changes.',
        prevention:
          'Maintain balanced nutrition, avoid over-irrigation and monitor soil moisture regularly.'
      },

      insects: {
        level: 'danger',
        title: 'Possible Pest Attack',
        severity: 'Moderate–High',
        cause:
          'Visible insects may indicate a pest population that could damage leaves, stems, flowers or fruits.',
        action:
          'Inspect both sides of leaves and nearby plants. Identify the pest before selecting a control method. Prefer locally recommended integrated pest-management practices.',
        prevention:
          'Scout the field regularly and monitor beneficial insects and pest populations.'
      },

      wilting: {
        level: 'danger',
        title: 'Possible Water, Root or Disease Stress',
        severity: 'Moderate–High',
        cause:
          'Wilting can result from water shortage, waterlogging, root damage, disease or environmental stress.',
        action:
          'Check soil moisture and drainage immediately. Inspect the stem and root zone if possible. Avoid blindly increasing irrigation until the cause is understood.',
        prevention:
          'Maintain proper drainage, monitor irrigation and inspect plants early for disease or pest symptoms.'
      }
    }

    setHealthResult(results[symptom])
  }

  // --------------------------------------------------
  // LIVE WEATHER
  // --------------------------------------------------

  const checkWeather = async () => {
    if (!location.trim()) {
      setWeatherError('Please enter your village or city name first 📍')
      setWeatherResult(null)
      return
    }

    setWeatherLoading(true)
    setWeatherError('')
    setWeatherResult(null)

    try {
      const geoResponse = await fetch(
        `https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(
          location.trim()
        )}&count=1&language=en&format=json`
      )

      if (!geoResponse.ok) {
        throw new Error('Location search failed')
      }

      const geoData = await geoResponse.json()

      if (!geoData.results || geoData.results.length === 0) {
        setWeatherError(
          `Could not find "${location}". Try a nearby city or district name.`
        )
        return
      }

      const place = geoData.results[0]

      const weatherResponse = await fetch(
        `https://api.open-meteo.com/v1/forecast?latitude=${place.latitude}&longitude=${place.longitude}&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,precipitation,rain,weather_code,wind_speed_10m&timezone=auto`
      )

      if (!weatherResponse.ok) {
        throw new Error('Weather request failed')
      }

      const data = await weatherResponse.json()

      if (!data.current) {
        throw new Error('Current weather unavailable')
      }

      const current = data.current

      const weatherCodeMap = {
        0: '☀️ Clear sky',
        1: '🌤️ Mainly clear',
        2: '⛅ Partly cloudy',
        3: '☁️ Overcast',
        45: '🌫️ Fog',
        48: '🌫️ Rime fog',
        51: '🌦️ Light drizzle',
        53: '🌦️ Moderate drizzle',
        55: '🌧️ Dense drizzle',
        56: '🌧️ Freezing drizzle',
        57: '🌧️ Heavy freezing drizzle',
        61: '🌦️ Slight rain',
        63: '🌧️ Moderate rain',
        65: '🌧️ Heavy rain',
        66: '🌧️ Freezing rain',
        67: '🌧️ Heavy freezing rain',
        71: '🌨️ Slight snowfall',
        73: '🌨️ Moderate snowfall',
        75: '❄️ Heavy snowfall',
        77: '🌨️ Snow grains',
        80: '🌦️ Rain showers',
        81: '🌧️ Moderate rain showers',
        82: '⛈️ Heavy rain showers',
        85: '🌨️ Snow showers',
        86: '❄️ Heavy snow showers',
        95: '⛈️ Thunderstorm',
        96: '⛈️ Thunderstorm with hail',
        99: '⛈️ Severe thunderstorm with hail'
      }

      const condition =
        weatherCodeMap[current.weather_code] || '🌦️ Variable conditions'

      let farmingAdvice = ''

      if (current.rain > 0 || current.precipitation > 0) {
        farmingAdvice =
          '🌧️ Rain is currently being observed. Avoid unnecessary irrigation and monitor field drainage.'
      } else if (current.temperature_2m >= 35) {
        farmingAdvice =
          '🔥 High temperature detected. Monitor crop water stress and soil moisture carefully.'
      } else if (current.temperature_2m <= 15) {
        farmingAdvice =
          '❄️ Cooler conditions detected. Monitor sensitive crops for temperature stress.'
      } else if (current.wind_speed_10m >= 30) {
        farmingAdvice =
          '💨 Strong wind conditions detected. Check young plants and avoid unnecessary spraying during strong winds.'
      } else {
        farmingAdvice =
          '🌱 Conditions appear suitable for normal field monitoring. Continue checking soil moisture and crop health.'
      }

      setWeatherResult({
        place: `${place.name}${place.admin1 ? `, ${place.admin1}` : ''}${
          place.country ? `, ${place.country}` : ''
        }`,
        condition,
        temperature: current.temperature_2m,
        feelsLike: current.apparent_temperature,
        humidity: current.relative_humidity_2m,
        rain: current.rain,
        precipitation: current.precipitation,
        wind: current.wind_speed_10m,
        advice: farmingAdvice
      })
    } catch (error) {
      setWeatherError(
        '⚠️ Live weather could not be loaded. Check your internet connection and try again.'
      )
    } finally {
      setWeatherLoading(false)
    }
  }

  // --------------------------------------------------
  // IRRIGATION
  // --------------------------------------------------

  const planIrrigation = () => {
    if (!irrigationCrop || !irrigationSoil) {
      setIrrigationResult('Please select crop and soil type first.')
      return
    }

    if (irrigationCrop === 'rice') {
      setIrrigationResult(
        '💧 Rice generally requires higher and more consistent water availability. Monitor field water conditions and avoid unnecessary irrigation.'
      )
    } else if (irrigationCrop === 'cotton') {
      setIrrigationResult(
        '💧 Cotton needs controlled irrigation. Avoid excessive watering and monitor soil moisture around the root zone.'
      )
    } else if (irrigationCrop === 'groundnut') {
      setIrrigationResult(
        '💧 Groundnut benefits from timely irrigation during important growth stages. Avoid waterlogging and check soil moisture before irrigation.'
      )
    } else if (irrigationCrop === 'chickpea') {
      setIrrigationResult(
        '💧 Chickpea needs careful irrigation management. Avoid excessive water and monitor soil moisture.'
      )
    } else {
      setIrrigationResult(
        '💧 Irrigation Guide: Check soil moisture before watering and avoid over-irrigation.'
      )
    }
  }

  // --------------------------------------------------
  // AI FARMER ASSISTANT
  // --------------------------------------------------

  const askAI = async () => {
    if (!question.trim()) {
      setAiResult('Please enter your farming question first.')
      return
    }

    setAiLoading(true)
    setAiResult('🤖 KrishiRakshak AI is thinking...')

    try {
      const response = await fetch('http://localhost:5000/api/ask', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          question: question.trim()
        })
      })

      const data = await response.json()

      if (!response.ok || !data.success) {
        throw new Error(data.message || 'AI request failed')
      }

      setAiResult(
        `🤖 ${data.answer}\n\n📂 Category: ${data.category}\n🎯 Confidence: ${data.confidence}`
      )
    } catch (error) {
      setAiResult(
        '⚠️ AI server connection failed.\n\nPlease make sure the KrishiRakshak backend is running on port 5000.'
      )
    } finally {
      setAiLoading(false)
    }
  }

  // --------------------------------------------------
  // NAVIGATION
  // --------------------------------------------------

  const openTool = (tool) => {
    setActiveTool(tool)
  }

  const goBack = () => {
    setActiveTool(null)
  }

  // --------------------------------------------------
  // LANDING
  // --------------------------------------------------

  if (!started) {
    return (
      <div className="app">
        <section className="hero">
          <div className="hero-card">
            <div className="hero-icon">🌾</div>

            <p className="eyebrow">
              SMART AGRICULTURE • AI ASSISTED
            </p>

            <h1>
              KrishiRakshak <span>AI</span>
            </h1>

            <p>
              A farmer-first digital platform for crop health awareness,
              recommendations, live weather intelligence and actionable farm
              guidance.
            </p>

            <button
              className="hero-button"
              onClick={() => setStarted(true)}
            >
              ENTER KRISHIRAKSHAK →
            </button>
          </div>
        </section>
      </div>
    )
  }

  // --------------------------------------------------
  // TOOL PAGE
  // --------------------------------------------------

  if (activeTool) {
    return (
      <div className="app tool-page">
        <nav className="navbar">
          <div className="nav-brand">
            🌾 KrishiRakshak <span>AI</span>
          </div>

          <button className="nav-back" onClick={goBack}>
            ← Dashboard
          </button>
        </nav>

        <main className="workspace">

          {/* CROP RECOMMENDATION */}

          {activeTool === 'crop' && (
            <section className="workspace-card">
              <div className="workspace-header">
                <p className="eyebrow">
                  DECISION SUPPORT MODULE
                </p>

                <h1>🌱 Crop Recommendation</h1>

                <p>
                  Get a suitable crop suggestion using soil, season and
                  water availability.
                </p>
              </div>

              <div className="step-badge">
                01 • FARM CONDITIONS
              </div>

              <div className="crop-form">
                <label>
                  Soil Type

                  <select
                    value={soil}
                    onChange={(e) =>
                      setSoil(e.target.value)
                    }
                  >
                    <option value="">
                      Select soil
                    </option>

                    <option value="black">
                      Black Soil
                    </option>

                    <option value="loamy">
                      Loamy Soil
                    </option>

                    <option value="red">
                      Red Soil
                    </option>

                    <option value="sandy">
                      Sandy Soil
                    </option>
                  </select>
                </label>

                <label>
                  Season

                  <select
                    value={season}
                    onChange={(e) =>
                      setSeason(e.target.value)
                    }
                  >
                    <option value="">
                      Select season
                    </option>

                    <option value="kharif">
                      Kharif
                    </option>

                    <option value="rabi">
                      Rabi
                    </option>

                    <option value="summer">
                      Summer
                    </option>
                  </select>
                </label>

                <label>
                  Water Availability

                  <select
                    value={water}
                    onChange={(e) =>
                      setWater(e.target.value)
                    }
                  >
                    <option value="">
                      Select availability
                    </option>

                    <option value="high">
                      High
                    </option>

                    <option value="moderate">
                      Moderate
                    </option>

                    <option value="low">
                      Low
                    </option>
                  </select>
                </label>
              </div>

              <button
                className="recommend-button"
                onClick={recommendCrop}
              >
                Analyze Conditions 🌱
              </button>

              {recommendation && (
                <div className="recommendation">
                  <strong>
                    AI Recommendation
                  </strong>

                  <p>
                    {recommendation}
                  </p>
                </div>
              )}
            </section>
          )}

          {/* CROP HEALTH */}

          {activeTool === 'health' && (
            <section className="workspace-card">
              <div className="workspace-header">
                <p className="eyebrow">
                  CROP HEALTH INTELLIGENCE
                </p>

                <h1>
                  🐛 Crop Health AI
                </h1>

                <p>
                  Select the crop and visible symptom to receive an initial
                  health assessment.
                </p>
              </div>

              <div className="step-badge">
                01 • OBSERVATION
              </div>

              <div className="crop-form">
                <label>
                  Crop

                  <select
                    value={healthCrop}
                    onChange={(e) => {
                      setHealthCrop(e.target.value)
                      setHealthResult(null)
                    }}
                  >
                    <option value="">
                      Select crop
                    </option>

                    <option value="rice">
                      Rice
                    </option>

                    <option value="cotton">
                      Cotton
                    </option>

                    <option value="groundnut">
                      Groundnut
                    </option>

                    <option value="chickpea">
                      Chickpea
                    </option>

                    <option value="millet">
                      Millet
                    </option>
                  </select>
                </label>

                <label>
                  Observed Symptom

                  <select
                    value={symptom}
                    onChange={(e) => {
                      setSymptom(e.target.value)
                      setHealthResult(null)
                    }}
                  >
                    <option value="">
                      Select symptom
                    </option>

                    <option value="spots">
                      Leaf Spots
                    </option>

                    <option value="yellow">
                      Yellow Leaves
                    </option>

                    <option value="insects">
                      Visible Insects
                    </option>

                    <option value="wilting">
                      Wilting
                    </option>
                  </select>
                </label>
              </div>

              <button
                className="recommend-button"
                onClick={checkHealth}
              >
                Analyze Crop Health 🔍
              </button>

              {healthResult && (
                <div
                  className={`health-result ${
                    healthResult.level
                  }`}
                >
                  <div className="health-result-top">
                    <div>
                      <span className="health-label">
                        INITIAL AI ASSESSMENT
                      </span>

                      <h2>
                        {healthResult.title}
                      </h2>
                    </div>

                    <div className="severity-badge">
                      Severity:{' '}
                      {healthResult.severity}
                    </div>
                  </div>

                  <div className="health-sections">
                    <div>
                      <span>
                        🔎 LIKELY CAUSE
                      </span>

                      <p>
                        {healthResult.cause}
                      </p>
                    </div>

                    <div>
                      <span>
                        ⚡ IMMEDIATE ACTION
                      </span>

                      <p>
                        {healthResult.action}
                      </p>
                    </div>

                    <div>
                      <span>
                        🛡️ PREVENTION
                      </span>

                      <p>
                        {healthResult.prevention}
                      </p>
                    </div>
                  </div>

                  <div className="expert-warning">
                    ⚠️ <strong>Important:</strong>{' '}
                    This is an initial decision-support
                    assessment, not a confirmed diagnosis.
                    Confirm crop problems with a qualified
                    agricultural expert before using
                    pesticides or fungicides.
                  </div>
                </div>
              )}
            </section>
          )}

          {/* WEATHER */}

          {activeTool === 'weather' && (
            <section className="workspace-card">
              <div className="workspace-header">
                <p className="eyebrow">
                  LIVE WEATHER INTELLIGENCE
                </p>

                <h1>
                  🌦️ Live Weather
                </h1>

                <p>
                  Search a village or city to fetch current weather conditions
                  and farming guidance.
                </p>
              </div>

              <div className="weather-form">
                <label>
                  Village / City

                  <input
                    type="text"
                    placeholder="e.g. Kadapa"
                    value={location}
                    onChange={(e) => {
                      setLocation(e.target.value)
                      setWeatherError('')
                    }}
                    onKeyDown={(e) => {
                      if (e.key === 'Enter') {
                        checkWeather()
                      }
                    }}
                  />
                </label>
              </div>

              <button
                className="recommend-button"
                onClick={checkWeather}
                disabled={weatherLoading}
              >
                {weatherLoading
                  ? 'Fetching Live Weather...'
                  : 'Check Live Weather 🌦️'}
              </button>

              {weatherError && (
                <div className="recommendation">
                  <strong>
                    Weather Error
                  </strong>

                  <p>
                    {weatherError}
                  </p>
                </div>
              )}

              {weatherResult && (
                <div className="weather-result">
                  <div className="weather-location">
                    <span>
                      📍 LIVE LOCATION
                    </span>

                    <h2>
                      {weatherResult.place}
                    </h2>

                    <p>
                      {weatherResult.condition}
                    </p>
                  </div>

                  <div className="weather-grid">

                    <div className="weather-box">
                      <span>🌡️</span>

                      <strong>
                        {weatherResult.temperature}°C
                      </strong>

                      <small>
                        Temperature
                      </small>
                    </div>

                    <div className="weather-box">
                      <span>🌡️</span>

                      <strong>
                        {weatherResult.feelsLike}°C
                      </strong>

                      <small>
                        Feels Like
                      </small>
                    </div>

                    <div className="weather-box">
                      <span>💧</span>

                      <strong>
                        {weatherResult.humidity}%
                      </strong>

                      <small>
                        Humidity
                      </small>
                    </div>

                    <div className="weather-box">
                      <span>🌧️</span>

                      <strong>
                        {weatherResult.rain} mm
                      </strong>

                      <small>
                        Rain
                      </small>
                    </div>

                    <div className="weather-box">
                      <span>💨</span>

                      <strong>
                        {weatherResult.wind} km/h
                      </strong>

                      <small>
                        Wind
                      </small>
                    </div>

                    <div className="weather-box">
                      <span>🌧️</span>

                      <strong>
                        {weatherResult.precipitation} mm
                      </strong>

                      <small>
                        Precipitation
                      </small>
                    </div>

                  </div>

                  <div className="weather-advice">
                    <strong>
                      🌾 FARMING ADVISORY
                    </strong>

                    <p>
                      {weatherResult.advice}
                    </p>
                  </div>

                  <p className="weather-source">
                    Live weather data powered by Open-Meteo.
                  </p>
                </div>
              )}
            </section>
          )}

          {/* IRRIGATION */}

          {activeTool === 'irrigation' && (
            <section className="workspace-card">
              <div className="workspace-header">
                <p className="eyebrow">
                  WATER MANAGEMENT
                </p>

                <h1>
                  💧 Irrigation Planner
                </h1>

                <p>
                  Get simple irrigation guidance based on crop and soil
                  conditions.
                </p>
              </div>

              <div className="crop-form">
                <label>
                  Crop

                  <select
                    value={irrigationCrop}
                    onChange={(e) =>
                      setIrrigationCrop(
                        e.target.value
                      )
                    }
                  >
                    <option value="">
                      Select crop
                    </option>

                    <option value="rice">
                      Rice
                    </option>

                    <option value="cotton">
                      Cotton
                    </option>

                    <option value="groundnut">
                      Groundnut
                    </option>

                    <option value="chickpea">
                      Chickpea
                    </option>

                    <option value="millet">
                      Millet
                    </option>
                  </select>
                </label>

                <label>
                  Soil

                  <select
                    value={irrigationSoil}
                    onChange={(e) =>
                      setIrrigationSoil(
                        e.target.value
                      )
                    }
                  >
                    <option value="">
                      Select soil
                    </option>

                    <option value="black">
                      Black Soil
                    </option>

                    <option value="loamy">
                      Loamy Soil
                    </option>

                    <option value="red">
                      Red Soil
                    </option>

                    <option value="sandy">
                      Sandy Soil
                    </option>
                  </select>
                </label>
              </div>

              <button
                className="recommend-button"
                onClick={planIrrigation}
              >
                Generate Irrigation Plan 💧
              </button>

              {irrigationResult && (
                <div className="recommendation">
                  <strong>
                    Water Guidance
                  </strong>

                  <p>
                    {irrigationResult}
                  </p>
                </div>
              )}
            </section>
          )}

          {/* AI ASSISTANT */}

          {activeTool === 'ai' && (
            <section className="workspace-card ai-workspace">
              <div className="workspace-header">
                <p className="eyebrow">
                  AI FARMER ASSISTANT
                </p>

                <h1>
                  🤖 Ask KrishiRakshak AI
                </h1>

                <p>
                  Ask a farming-related question and receive decision-support
                  guidance from the KrishiRakshak backend.
                </p>
              </div>

              <div className="ai-status">
                <span className="status-dot"></span>

                <span>
                  KrishiRakshak AI Backend
                </span>

                <span className="status-online">
                  LOCAL
                </span>
              </div>

              <div className="ai-question-box">
                <textarea
                  placeholder="Example: When should I irrigate my groundnut crop?"
                  value={question}
                  onChange={(e) =>
                    setQuestion(e.target.value)
                  }
                  onKeyDown={(e) => {
                    if (
                      e.key === 'Enter' &&
                      !e.shiftKey
                    ) {
                      e.preventDefault()
                      askAI()
                    }
                  }}
                />
              </div>

              <div className="ai-hint">
                Press <strong>Enter</strong> to ask •
                <strong> Shift + Enter</strong> for a new line
              </div>

              <button
                className="recommend-button"
                onClick={askAI}
                disabled={aiLoading}
              >
                {aiLoading
